# cc-contextbar configuration
#
# Copy this file to ~/.claude/ctxbar/pricing.env and edit. (The installer does
# this for you.) If this file is ABSENT, cc-contextbar auto-detects pricing
# from the model name (see the PRESET table in statusline.sh). If it EXISTS,
# these values are used as-is — that disables auto-detection.
#
# All prices are per 1,000,000 tokens. Defaults to 0, in which case the cost
# shows "--" until you set them.

# --- pricing (USD per 1M tokens) ---
PRICE_INPUT=1.00        # regular input + cache creation
PRICE_CACHE_READ=0.10   # cache read (prompt-cache hits — cheaper)
PRICE_OUTPUT=4.00       # output
CUR='$'                 # currency symbol ($, ¥, €, …)

# --- appearance (optional) ---
# CTXBAR_SEGMENTS=10     # number of bar cells
# CTXBAR_FILL=█          # filled cell glyph
# CTXBAR_EMPTY=░         # empty cell glyph
