# cc-contextbar pricing configuration
#
# Copy this file to ~/.claude/ctxbar/pricing.env and fill in YOUR provider's
# rates (the installer does this for you). Units: price per 1,000,000 tokens.
# All values default to 0, in which case the cost shows "--" until you set them.

PRICE_INPUT=1.00        # regular input + cache creation
PRICE_CACHE_READ=0.10   # cache read (prompt-cache hits — cheaper)
PRICE_OUTPUT=4.00       # output
CUR='$'                 # currency symbol (e.g. $, ¥, €)
